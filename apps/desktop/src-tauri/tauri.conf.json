{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MP4 to IFO",
  "version": "../package.json",
  "identifier": "io.github.sena10x.mp4-to-ifo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "MP4 to IFO",
        "width": 720,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.video",
    "copyright": "© 2026 SENA",
    "shortDescription": "Create DVD-Video files from an MP4",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/node", "binaries/ffmpeg", "binaries/ffprobe", "binaries/dvdauthor"],
    "resources": {
      "engine/": "engine/",
      "../../../third-party/licenses/": "licenses/",
      "../../../third-party/build-info/": "build-info/",
      "../../../third-party/sources.json": "build-info/sources.json",
      "../../../third-party/README.md": "licenses/THIRD-PARTY.md",
      "../../../LICENSE": "licenses/MP4-to-IFO-MIT.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true
    }
  }
}
