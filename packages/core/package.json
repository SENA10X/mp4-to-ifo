{
  "name": "@mp4-to-ifo/core",
  "version": "0.1.0",
  "private": true,
  "description": "Conversion core for MP4 to IFO: MP4 to DVD-Video (VIDEO_TS, ZIP, ISO) with verification.",
  "license": "MIT",
  "author": "SENA",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "test:regression": "node --test --test-concurrency=1 \"test/regression/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
